{
  "name": "portfolio-admin-dashboard",
  "version": "1.0.0",
  "description": "Portfolio étudiant interactif avec dashboard d'édition en temps réel",
  "main": "server.js",
  "scripts": {
    "predev": "npm run build:css",
    "dev": "node server.js",
    "start": "node server.js",
    "test": "node --test \"tests/*.test.js\"",
    "vendor:pdfjs": "node scripts/vendor-pdfjs.js",
    "build:css": "tailwindcss -i ./public/css/tailwind-src.css -o ./public/css/tailwind-build.css --minify",
    "watch:css": "tailwindcss -i ./public/css/tailwind-src.css -o ./public/css/tailwind-build.css --watch"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0"
  },
  "devDependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@phosphor-icons/core": "^2.1.1",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.11",
    "pdfjs-dist": "4.10.38",
    "tailwindcss": "^3.4.19"
  },
  "author": "Jordan",
  "license": "ISC"
}
