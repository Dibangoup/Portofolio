# Copiez ce fichier en .env (jamais commité - voir .gitignore) et définissez vos
# propres identifiants pour protéger /dashboard.html et /api/save.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=changez-moi

# Port du serveur local (optionnel)
# PORT=3000

# Publication automatique sur GitHub à chaque enregistrement du dashboard (commit + push sur
# main, ce qui déclenche le déploiement Vercel). Git doit déjà être authentifié sur cette machine.
# GIT_AUTO_PUBLISH=true
